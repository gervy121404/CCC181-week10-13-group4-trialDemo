{
  "openapi": "3.1.0",
  "info": {
    "title": "CampusConnect API",
    "version": "1.0.0",
    "description": ""
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "http://localhost:3000/api/v1/health",
        "responses": {}
      }
    },
    "/api/v1/sessions": {
      "post": {
        "summary": "http://localhost:3000/api/v1/sessions",
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "email": "student@campusconnect.test",
                "password": "Campus26"
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "summary": "http://localhost:3000/api/v1/users/me(with authorization bearer token)",
        "responses": {},
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}